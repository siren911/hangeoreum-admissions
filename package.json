{
  "name": "hangeoreum-admissions",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @j/web",
    "dev:api": "npm run dev --workspace @j/data-api",
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "npm run db:local --workspace @j/data-api",
    "build": "npm run build --workspace @j/web",
    "start": "npm run start --workspace @j/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/data-api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:check": "npm run check --workspace @j/data-api",
    "test:storage": "node scripts/test-storage.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.131.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
